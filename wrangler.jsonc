{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dasty2-marketplace-dev",
  "compatibility_date": "2026-05-26",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "routes": [
    { "pattern": "dev.dasty2mndalan.com/*", "zone_name": "dasty2mndalan.com" },
    { "pattern": "dev.mndallan.com/*", "zone_name": "mndallan.com" }
  ],
  "keep_vars": true,
  "secrets": {
    "required": ["RESEND_API_KEY"]
  },
  "upload_source_maps": true,
  "triggers": {
    "crons": ["0 22 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "vars": {
    "VITE_CONVEX_URL": "https://grandiose-pig-440.convex.cloud",
    "VITE_CONVEX_SITE_URL": "https://grandiose-pig-440.convex.site",
    "VITE_R2_PUBLIC_URL": "https://dev-assets.mndallan.com"
  },
  "env": {
    "production": {
      "name": "dasty2-marketplace-pro",
      "routes": [
        { "pattern": "dasty2mndalan.com/*", "zone_name": "dasty2mndalan.com" },
        { "pattern": "www.dasty2mndalan.com/*", "zone_name": "dasty2mndalan.com" },
        { "pattern": "mndallan.com/*", "zone_name": "mndallan.com" },
        { "pattern": "www.mndallan.com/*", "zone_name": "mndallan.com" }
      ],
      "keep_vars": true,
      "secrets": {
        "required": ["RESEND_API_KEY"]
      },
      "vars": {
        "VITE_CONVEX_URL": "https://artful-firefly-452.convex.cloud",
        "VITE_CONVEX_SITE_URL": "https://artful-firefly-452.convex.site",
        "VITE_R2_PUBLIC_URL": "https://assets.mndallan.com"
      }
    },
    "dev": {
      "name": "dasty2-marketplace-dev",
      "keep_vars": true,
      "secrets": {
        "required": ["RESEND_API_KEY"]
      },
      "vars": {
        "VITE_CONVEX_URL": "https://grandiose-pig-440.convex.cloud",
        "VITE_CONVEX_SITE_URL": "https://grandiose-pig-440.convex.site",
        "VITE_R2_PUBLIC_URL": "https://dev-assets.mndallan.com"
      }
    }
  }
}
