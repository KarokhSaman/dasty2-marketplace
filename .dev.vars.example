# Copy to .dev.vars (gitignored). Loaded by `wrangler dev` / vite dev via @cloudflare/vite-plugin.
# VITE_* public values stay in .env (Vite inlines them at build time).

# Convex (server-side)
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment

# Clerk (server-side)
CLERK_SECRET_KEY=sk_test_...

# Cloudinary (server-side, used by /api/upload)
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# Resend (server-side email — OTP)
RESEND_API_KEY=re_...
