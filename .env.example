# ---------------------------------------------------------------------------
# Public, build-time env vars (Vite inlines anything prefixed with VITE_ into
# the client bundle). In Cloudflare Workers Builds, set these as build
# variables so they exist before `vite build` runs.
# ---------------------------------------------------------------------------
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
VITE_R2_PUBLIC_URL=https://pub-xxxx.r2.dev
VITE_WHATSAPP_NUMBER=9647509717177

# ---------------------------------------------------------------------------
# Local/runtime values. Keep real values in `.env.local`. In Cloudflare, set
# secrets through `wrangler secret put <NAME>` or the dashboard under the
# Worker's runtime variables and secrets.
# ---------------------------------------------------------------------------
# Used only by the Convex CLI (`convex dev`/`codegen`), not by the app runtime.
# CONVEX_DEPLOYMENT=dev:your-deployment

# Auth: VerifySpeed phone-OTP + self-hosted RS256 session JWT.
# These live in CONVEX env only (never in the Worker / this file). Set with
# `npx convex env set <NAME> <value>` per deployment:
#   VERIFYSPEED_SERVER_KEY  — VerifySpeed dashboard server-key
#   JWT_PRIVATE_KEY         — base64(PKCS8 PEM), from scripts/gen-jwt-keys.mjs
#   JWKS                    — public JWK set JSON, from scripts/gen-jwt-keys.mjs
# CONVEX_SITE_URL is provided automatically by Convex (used as the JWT issuer).
# For local browser QA only, enable deterministic mock accounts on the Convex
# development deployment. Never set this on production:
#   npx convex env set ALLOW_MOCK_AUTH true

# Cloudflare R2 credentials live in Convex env, not here:
# R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_ENDPOINT, R2_BUCKET, R2_PUBLIC_URL

# Resend (server-side email)
# RESEND_API_KEY=re_...
