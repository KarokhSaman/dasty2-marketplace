# Convex
# The app (client AND server functions) reads the deployment URL from the
# Vite-inlined public value VITE_CONVEX_URL — it's the single source of truth.
# In Cloudflare Workers Builds, set VITE_* as "Build variables" so they're
# inlined at build time. No server-side CONVEX_URL is needed by the app.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
# Used only by the Convex CLI (`convex dev`/`codegen`), not by the app runtime.
CONVEX_DEPLOYMENT=dev:your-deployment

# Clerk
CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Set this in Convex env too. Example: https://your-app.clerk.accounts.dev
CLERK_FRONTEND_API_URL=https://your-clerk-frontend-api.clerk.accounts.dev
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up
CLERK_AFTER_SIGN_IN_URL=/seller
CLERK_AFTER_SIGN_UP_URL=/seller
VITE_CLERK_SIGN_IN_URL=/sign-in
VITE_CLERK_SIGN_UP_URL=/sign-up
VITE_CLERK_AFTER_SIGN_IN_URL=/seller
VITE_CLERK_AFTER_SIGN_UP_URL=/seller

# Cloudflare R2 — public bucket base URL (no trailing slash)
# e.g. https://pub-xxxx.r2.dev or https://cdn.yourdomain.com
# R2 credentials (R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY/R2_ENDPOINT/R2_BUCKET) live in Convex env, not here.
VITE_R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Resend (server-side email)
RESEND_API_KEY=re_...

# WhatsApp link target
VITE_WHATSAPP_NUMBER=9647509717177
